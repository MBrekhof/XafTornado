      {
        "id": "data-path",
        "label": "Data path",
        "focus": [
          "tools",
          "objectspace",
          "db"
        ],
        "note": "Every read and write goes through the calling user's secured ObjectSpace."
      },
      {
        "id": "ui-path",
        "label": "Driving the UI",
        "focus": [
          "tools",
          "queue",
          "views"
        ],
        "note": "Navigate, filter, save and close run on the UI thread and report what actually happened."
