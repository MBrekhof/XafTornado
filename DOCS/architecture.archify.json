  "cards": [
    {
      "dot": "cyan",
      "title": "Per user, not per process",
      "items": [
        "Chat, tools, view context, navigation queue and log: one per Blazor circuit or WinForms app",
        "Only the TornadoApi (provider keys) is shared"
      ]
    },
    {
      "dot": "rose",
      "title": "Security boundary",
      "items": [
        "Tools read and write through the user's secured ObjectSpace",
        "Permissions are checked first; a refusal comes back as { error: \"permission denied\" }"
      ]
    },
    {
      "dot": "emerald",
      "title": "Truthful tools",
      "items": [
        "Every tool returns one JSON object; errors say why",
        "UI requests execute inline and report ok only when the window did it"
      ]
    }
  ]
